{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "chromium",
      "headless": false,
      "args": [
        "--disable-extensions-except=.output/chrome-mv3",
        "--load-extension=.output/chrome-mv3"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 800
      }
    }
  }
}
